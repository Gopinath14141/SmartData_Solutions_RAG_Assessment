# Copy to `.env` and fill in OPENAI_API_KEY. `.env` is gitignored and must never be committed.
# Every value below is read by app/config/settings.py — nothing is hardcoded in the modules.

# ─────────────────────────── OpenAI ───────────────────────────
OPENAI_API_KEY=sk-replace-me

# Model selection — see docs/design-decisions.md D2 and D6.
# Two generation models by design: cheap for the frequent text path,
# stronger for the rare-but-hard vision path.
LLM_MODEL=gpt-4o-mini
VISION_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1200
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# ─────────────────────────── Qdrant ───────────────────────────
# Host is `localhost` when running the app directly, `qdrant` under docker compose.
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=aapl_10q_2022_q3
QDRANT_TIMEOUT_SECONDS=30
QDRANT_STARTUP_RETRIES=10
QDRANT_STARTUP_BACKOFF_SECONDS=2.0

# ────────────────────────── Document ──────────────────────────
DOCUMENT_ID=AAPL_2022_Q3_10Q
DOCUMENT_PATH=data/raw/2022_Q3_AAPL.pdf
DOCUMENT_URL=https://raw.githubusercontent.com/docugami/KG-RAG-datasets/main/sec-10-q/data/v1/docs/2022%20Q3%20AAPL.pdf

# ───────────────── Chunking — architecture.md §6 ───────────────
# Tuned against the evaluation set, not guessed. Mean page text is ~2,500 chars,
# so 900 yields roughly three chunks per narrative page.
TEXT_CHUNK_SIZE=900
TEXT_CHUNK_OVERLAP=150

# ──────────────── Retrieval — architecture.md §7 ───────────────
RETRIEVAL_TOP_K=8
DENSE_TOP_K=20
BM25_TOP_K=20
RRF_K=60
# Soft rank bias applied by the query router. Never a hard filter — see architecture.md §7.
# RRF scores are compressed, so this moves a chunk further than it appears: a boosted
# chunk at rank r overtakes rank 1 when r < 1 + (RRF_K + 1) * ROUTER_BOOST. At RRF_K=60,
# 0.05 is worth roughly three rank positions; 0.15 would be worth ten.
ROUTER_BOOST=0.05

# ───────────────────────── Rendering ──────────────────────────
PAGE_RENDER_DPI=150
FIGURE_MIN_DIMENSION=32

# ─────────────────────────── Serving ──────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
